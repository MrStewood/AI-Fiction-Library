# Copy to a host-only env file (never commit real secrets).
# Board-aware studio CLI reads these names only.

STUDIO_API_URL=https://your-board.example
STUDIO_BOARD_TOKEN=replace-me
STUDIO_COMPANY_ID=replace-me
# Must be the parent that CONTAINS company folders (not .../projects/<company_id>).
STUDIO_PROJECTS_ROOT=/absolute/path/to/projects
# Pattern for agent-visible workspace roots. Tokens: {company_id} {project_id}
STUDIO_WORKSPACE_ABS_TEMPLATE={projects_root}/{company_id}/{project_id}/_default
STUDIO_CLI="python3 tools/studio.py"
# Optional: correlation header/name if your board API needs a run id
# STUDIO_RUN_ID_HEADER=
# STUDIO_RUN_ID=
# Optional: container name for start-book workspace ownership fix
# STUDIO_RUNTIME_CONTAINER=your-runtime-container
AI_FICTION_LIBRARY=/absolute/path/to/AI-Fiction-Library
